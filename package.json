    "next": "^16.2.12",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "siwe": "^3.0.0",
    "viem": "^2.55.8",
    "wagmi": "^3.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
