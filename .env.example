# ── chain (Robinhood Chain, an Arbitrum L2 · ETH gas) ──────────────────────
# TESTNET (recommended for development):
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_NAME="Robinhood Chain Testnet"
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# MAINNET values, for reference:
#   NEXT_PUBLIC_CHAIN_ID=4663
#   NEXT_PUBLIC_CHAIN_NAME="Robinhood Chain"
#   NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
#   NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Server-side RPC (higher rate limit). Public endpoints are rate-limited and not
# recommended for production — use Alchemy: https://robinhood-testnet.g.alchemy.com/v2/{KEY}
RPC_URL_PRIVATE=https://rpc.testnet.chain.robinhood.com

# WalletConnect Cloud project id (required by RainbowKit). Create one free at
# https://cloud.reown.com  (formerly WalletConnect Cloud).
NEXT_PUBLIC_WC_PROJECT_ID=

# ── treasury (single custodial wallet) ─────────────────────────────────────
NEXT_PUBLIC_TREASURY_ADDRESS=  # players send collateral + ETH here (0x…40 hex)
TREASURY_PRIVATE_KEY=          # 0x + 64 hex — hot wallet signer, payouts only
TREASURY_MIN_ETH_WEI=100000000000000000     # 0.1 ETH alert threshold
PAYOUT_DAILY_CAP_WEI=10000000000000000000    # 10 ETH/day
PAYOUT_PER_TX_CAP_WEI=2000000000000000000    # 2 ETH/tx

# ── database (Supabase Postgres) ───────────────────────────────────────────
# Pooled connection (Transaction pooler, port 6543) for the app runtime.
# Append ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) for Prisma Migrate.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── infra ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_SECRET=                # 32+ bytes (openssl rand -hex 32)

# ── prices ─────────────────────────────────────────────────────────────────
# static  = built-in table for stocks + live ETH (Coinbase)
# onchain = Chainlink stock-token feeds on Robinhood Chain + live ETH (no key)
# api     = external HTTP feed (PRICE_FEED_URL); adapt parseResponse() in prices.ts
PRICE_SOURCE=static
PRICE_FEED_URL=                # required only when PRICE_SOURCE=api
PRICE_FEED_KEY=                # optional bearer token for the feed

# ── policy ─────────────────────────────────────────────────────────────────
SELL_POLICY=full               # winnings_only | full  (see README §9.2)
DEPOSIT_CONFIRMATIONS=12
PRICE_MAX_STALENESS_SEC=60
